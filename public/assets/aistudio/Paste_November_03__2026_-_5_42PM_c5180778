      const c=text[i];
      if(c==='"'){if(quoted&&text[i+1]==='"'){value+='"';i++;}else quoted=!quoted;}
      else if(c===','&&!quoted){row.push(value.trim());value='';}
      else if((c==='\n'||c==='\r')&&!quoted){if(c==='\r'&&text[i+1]==='\n')i++;row.push(value.trim());value='';if(row.some(Boolean))rows.push([...row]);row.length=0;}
      else value+=c;
    }
    if(quoted)throw new Error('Tanda kutip CSV belum ditutup.');
    row.push(value.trim());if(row.some(Boolean))rows.push(row);return rows;
  }
  async function importCsv(kind,button){
    const input=$(kind==='student'?'student-csv':'teacher-csv'),file=input.files[0];
    if(!file){notice('Pilih berkas CSV terlebih dahulu.');return;}
    if(!/\.csv$/i.test(file.name)||file.size>1000000){notice('Gunakan berkas .csv berukuran maksimal 1 MB.');return;}
    if(!loaded){notice('Tunggu Canva Sheet selesai dimuat.');return;}
    let rows;
    try{rows=parseCsv((await file.text()).replace(/^\uFEFF/,''));}catch(error){notice(error.message);return;}
    const headers=kind==='student'?['student_nisn','student_name','student_class','student_absence_number']:['teacher_name','subject_name'];
    if(!rows.length||headers.some((header,i)=>rows[0][i]!==header)){notice('Header CSV tidak sesuai template.');return;}
    const values=rows.slice(1);if(!values.length){notice('CSV tidak memiliki baris data.');return;}
    if(values.length>50){notice('Impor maksimal 50 baris sekali proses.');return;}
    let saved=0;
    button.disabled=true;
    try{
      for(const fields of values){
        if(backendRecords.length+saved>=999){notice(`Batas Canva Sheet tercapai setelah ${saved} baris. Hentikan impor.`);return;}
        const valid=kind==='student'
          ?fields.length===4&&/^\d{10}$/.test(fields[0])&&!!fields[1]&&/^[789][A-Z]$/.test(fields[2])&&/^\d{1,3}$/.test(fields[3])
          :fields.length===2&&fields.every(Boolean);
        if(!valid){notice(`Baris ${saved+2} tidak valid. ${saved} baris sebelumnya berhasil disimpan.`);return;}
        const record={record_type:kind};
        headers.forEach((key,i)=>record[key]=fields[i]);
        const result=await window.dataSdk.create(record);
        if(!result.isOk){notice(`${saved} baris berhasil disimpan; penyimpanan berikutnya tidak dapat dikonfirmasi. Periksa Canva Sheet sebelum mengulangi impor.`);return;}
        saved++;
        await new Promise(resolve=>setTimeout(resolve,550));
      }
      notice(`${saved} baris CSV berhasil disimpan ke Canva Sheet.${kind==='student'?' Identitas siswa tersimpan tidak dapat ditampilkan kembali di halaman ini.':''}`);
      input.value='';
    }catch{notice(`${saved} baris berhasil disimpan; proses berikutnya tidak dapat dikonfirmasi. Periksa Canva Sheet sebelum mengulangi impor.`);}
    finally{button.disabled=false;}
  }
  $('import-students').addEventListener('click',event=>importCsv('student',event.currentTarget));
  $('import-teachers').addEventListener('click',event=>importCsv('teacher',event.currentTarget));
  $('print-poster').addEventListener('click',()=>window.print());
  render();initialize();setInterval(()=>{renderSchedules();renderStudent();},30000);
})();
</script>
 
